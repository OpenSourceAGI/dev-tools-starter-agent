#### App
NEXT_PUBLIC_APP_NAME=CCCP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_EMAIL=
NEXT_PUBLIC_APP_DESCRIPTION=

#### Database (libSQL / Turso — leave empty for a local file at ./data/cccp.db)
# npm create cloud-db
DATABASE_URL=
DATABASE_AUTH_TOKEN=

#### Auth
# Required. Signs sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Encrypts stored cloud credentials at rest.
# Falls back to BETTER_AUTH_SECRET when unset. Generate: openssl rand -base64 32
# Rotating this makes already-stored secret keys unreadable — users must re-enter them.
CREDENTIALS_ENCRYPTION_KEY=

# Optional. Enables "Sign in with Google" — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Enables magic-link sign-in — https://resend.com/api-keys
RESEND_API_KEY=

#### AWS (optional)
# Fallback credentials for single-tenant installs. A user's own saved
# credentials always take priority over these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
