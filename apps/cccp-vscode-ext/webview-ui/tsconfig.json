{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vscode-webview"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../Cloud-Computer-Control-Panel/*"],
      // The reused CCCP components sit outside this package, so their bare
      // imports (react, lucide-react, radix) are pointed at the copies installed
      // here -- the same redirect `resolveCccpImportsHere()` performs at build
      // time in vite.config.ts.
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src"]
}
