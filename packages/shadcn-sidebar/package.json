{
  "name": "shadcn-sidebar",
  "version": "0.1.0",
  "description": "A generic, data-driven shadcn/ui-style app sidebar — drag-resizable column, offcanvas and icon-rail collapse modes, a magnifying app dock, accordion nav tree and an account menu with theme settings — extracted from debate-ai.com's app shell",
  "type": "module",
  "author": "vtempest",
  "license": "MIT",
  "homepage": "https://github.com/opensourceagi/dev-tools-starter-agent/tree/master/packages/shadcn-sidebar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensourceagi/dev-tools-starter-agent.git",
    "directory": "packages/shadcn-sidebar"
  },
  "bugs": {
    "url": "https://github.com/opensourceagi/dev-tools-starter-agent/issues"
  },
  "keywords": [
    "shadcn",
    "sidebar",
    "react",
    "tailwind",
    "dock",
    "navigation"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./demo": "./src/demo/index.ts",
    "./styles.css": "./src/styles/sidebar.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react-resizable-panels": "^4.14.4",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
