  "module": "./dist/manage-storage.js",
  "types": "./dist/manage-storage.d.ts",
  "type": "module",
  "keywords": [
    "s3",
    "r2",
    "b2",
    "cloudflare",
    "backblaze",
    "gcs",
    "google-cloud-storage",
    "aws",
    "amazon",
    "storage",
    "cloud",
    "cloud-storage",
    "file-storage",
    "multi-cloud"
  ],
  "author": "vtempest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/dev-tools-starter-agent.git",
    "directory": "packages/manage-storage"
  },
  "homepage": "https://github.com/OpenSourceAGI/dev-tools-starter-agent/tree/master/packages/manage-storage",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.44.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "deploy:vercel": "npx vercel deploy --prod",
    "typecheck:demo": "tsc --noEmit -p demo",
    "prepublishOnly": "npm run build",
    "ship": "npx standard-version --release-as patch; rm CHANGELOG.md; npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/manage-storage.d.ts",
      "import": "./dist/manage-storage.js"
    }
  },
  "files": [
    "dist"
  ]
}
