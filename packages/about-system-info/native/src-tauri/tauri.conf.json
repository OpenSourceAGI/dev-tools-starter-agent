{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "About System",
  "version": "0.1.0",
  "identifier": "com.opensourceagi.aboutsystem",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "About System",
        "url": "index.html",
        "width": 1040,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "OpenSourceAGI",
    "copyright": "OpenSourceAGI",
    "category": "Utility",
    "shortDescription": "CPU, memory, disk, network, and installed tooling for this machine, at a glance.",
    "longDescription": "A desktop window over the about-system CLI: 30+ system metrics — CPU and GPU, memory and swap, disk usage, uptime, public IP and ISP, containers, open ports, and installed developer tooling — collected on demand and shown as a single readable panel. Ships the CLI inside the app, so nothing needs to be installed first.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "externalBin": [
      "binaries/about-system"
    ]
  },
  "plugins": {}
}
