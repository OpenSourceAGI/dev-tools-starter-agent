{
  "name": "about-system-native",
  "version": "0.1.0",
  "description": "About System packaged as a native desktop app (scaffolded from native-app-wrapper)",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "scripts": {
    "configure": "node bin/cli.js configure",
    "icons": "node scripts/generate-icons.mjs",
    "icons:placeholder": "node scripts/generate-placeholder-icons.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "predev": "node bin/cli.js configure && node scripts/build-sidecar.mjs",
    "dev": "tauri dev",
    "prebuild:desktop": "node bin/cli.js configure && node scripts/build-sidecar.mjs",
    "build:desktop": "tauri build"
  },
  "keywords": [
    "tauri",
    "desktop-app",
